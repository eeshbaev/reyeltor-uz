{
  "expo": {
    "name": "Reyeltor-uz",
    "slug": "reyeltor-uz",
    "version": "1.4.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "reyeltor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090F",
      "tabletSplashScreen": "./assets/splash-icon.png",
      "tabletBackgroundColor": "#07090F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.reyeltor.app",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "NSPhotoLibraryUsageDescription": "Upload photos of your property listing.",
        "NSLocationWhenInUseUsageDescription": "Place your listing pin at your current location on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6EFE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "uz.reyeltor.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "reyeltor"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "37.0.0",
            "ndkVersion": "27.1.12297006",
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            },
            "frescoKitMemoryTrimmingMinimumUtilization": 0.33,
            "frescoBitmapMemoryCacheSize": 52428800,
            "frescoSmallImageMemoryCacheSize": 10485760,
            "minSdkVersion": 26
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload photos for your listings and profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Place your listing pin at your current location on the map."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "./plugins/withLibraryNdkVersion"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "24bcc57e-18b0-44d6-b79f-c9caddd0ce4a"
      }
    },
    "owner": "eeshbaev95"
  }
}
