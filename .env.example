EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Map tiles — the app uses CARTO by default (same maps as before).
# Get a free key (email only, no paid plan): https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_API_KEY=your_carto_basemap_key

# Optional: MapTiler replaces CARTO when set (geocoding + tiles). Leave blank to keep CARTO.
EXPO_PUBLIC_MAPTILER_KEY=

# Use a live Supabase project (Dashboard → Project Settings → API).
# If login/reset fail with "Cannot reach the Reyeltor server", the project URL is wrong or deleted.
# Add redirect URLs in Supabase → Authentication → URL configuration:
#   reyeltor://auth/reset-password

# Demo inventory (labeled DEMO, bundled in the app, never stored in Supabase):
#   auto = per district: show demos only where there are fewer than 15 real listings (default), on = always, off = never
EXPO_PUBLIC_DEMO_INVENTORY=auto
